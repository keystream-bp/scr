-- 1. MÀN HÌNH INTRO (HIỆN CHỮ "PVKA" VÀ CHẤM TRÒN XOAY)
--====================================================================--
local introHolder = Instance.new("Frame")
introHolder.Name = "IntroHolder"
introHolder.Size = UDim2.new(1, 0, 1, 0)
introHolder.BackgroundTransparency = 1
introHolder.Parent = screenGui

-- Chữ PVKA
local pvkaLabel = Instance.new("TextLabel")
pvkaLabel.Name = "PVKALabel"
pvkaLabel.Size = UDim2.new(0, 300, 0, 100)
pvkaLabel.AnchorPoint = Vector2.new(0.5, 0.5)
pvkaLabel.Position = UDim2.new(0.5, 0, 0.5, 0)
pvkaLabel.BackgroundTransparency = 1
pvkaLabel.Text = "PVKA"
pvkaLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
pvkaLabel.TextSize = 50
pvkaLabel.Font = Enum.Font.FredokaOne
pvkaLabel.TextTransparency = 1
pvkaLabel.Parent = introHolder

-- Tạo các chấm tròn loading xoay vòng quanh
local dots = {}
local numDots = 8
local radius = 45

for i = 1, numDots do
	local dot = Instance.new("Frame")
	dot.Size = UDim2.new(0, 10, 0, 10)
	dot.AnchorPoint = Vector2.new(0.5, 0.5)
	dot.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
	dot.BackgroundTransparency = 1
	
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = dot
	
	dot.Parent = introHolder
	table.insert(dots, dot)
end

-- Hiệu ứng quay vòng của các chấm tròn
local rotConn
local angle = 0
rotConn = RunService.RenderStepped:Connect(function(dt)
	angle = angle + dt * 3
	for i, dot in ipairs(dots) do
		local theta = angle + (i * (math.pi * 2 / numDots))
		local x = math.cos(theta) * radius
		local y = math.sin(theta) * radius
		dot.Position = UDim2.new(0.5, x, 0.5, y)
	end
end)

-- Chạy hiệu ứng Intro xuất hiện chữ và chấm tròn
TweenService:Create(pvkaLabel, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextTransparency = 0}):Play()
for _, dot in ipairs(dots) do
	TweenService:Create(dot, TweenInfo.new(0.6), {BackgroundTransparency = 0}):Play()
end

task.wait(1.8)

-- Hiệu ứng tắt Intro
TweenService:Create(pvkaLabel, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {TextTransparency = 1}):Play()
for _, dot in ipairs(dots) do
	TweenService:Create(dot, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
end
task.wait(0.5)

if rotConn then rotConn:Disconnect() end
introHolder:Destroy()

