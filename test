local tabESP = createTab("🎯 ESP Tính Năng")
local tabSettings = createTab("⚙️ Cài Đặt Chung")

local eggEspEnabled = false
local playerEspEnabled = false
local eggObjects = {}
local playerObjects = {}

local function createEggESP(item)
	local box = Drawing.new("Square")
	box.Visible = false
	box.Color = Color3.fromRGB(0, 255, 255)
	box.Thickness = 1.5
	box.Filled = false
	local text = Drawing.new("Text")
	text.Visible = false
	text.Color = Color3.fromRGB(255, 255, 255)
	text.Size = 13
	text.Center = true
	text.Outline = true
	eggObjects[item] = {Box = box, Text = text}
end

local function createPlayerESP(p)
	local box = Drawing.new("Square")
	box.Visible = false
	box.Color = Color3.fromRGB(255, 60, 60)
	box.Thickness = 1.5
	box.Filled = false
	local text = Drawing.new("Text")
	text.Visible = false
	text.Color = Color3.fromRGB(255, 255, 255)
	text.Size = 13
	text.Center = true
	text.Outline = true
	playerObjects[p] = {Box = box, Text = text}
end

Players.PlayerRemoving:Connect(function(p)
	if playerObjects[p] then
		if playerObjects[p].Box then playerObjects[p].Box:Remove() end
		if playerObjects[p].Text then playerObjects[p].Text:Remove() end
		playerObjects[p] = nil
	end
end)

RunService.RenderStepped:Connect(function()
	if eggEspEnabled then
		for _, obj in pairs(Workspace:GetDescendants()) do
			if obj:IsA("Model") or obj:IsA("Part") then
				if string.find(string.lower(obj.Name), "egg") then
					if not eggObjects[obj] then createEggESP(obj) end
					local tp = obj:IsA("Model") and obj.PrimaryPart or obj
					if not tp and obj:IsA("Model") then tp = obj:FindFirstChildWhichIsA("BasePart") end
					if tp then
						local vec, onScreen = Camera:WorldToViewportPoint(tp.Position)
						local objs = eggObjects[obj]
						if onScreen and objs then
							local dist = (Camera.CFrame.Position - tp.Position).Magnitude
							local sf = math.clamp(1200 / dist, 12, 350)
							objs.Box.Size = Vector2.new(sf * 0.8, sf)
							objs.Box.Position = Vector2.new(vec.X - objs.Box.Size.X / 2, vec.Y - objs.Box.Size.Y / 2)
							objs.Box.Visible = true
							objs.Text.Text = obj.Name .. " [" .. math.floor(dist) .. "m]"
							objs.Text.Position = Vector2.new(vec.X, vec.Y - objs.Box.Size.Y / 2 - 16)
							objs.Text.Visible = true
						else
							if objs then objs.Box.Visible = false; objs.Text.Visible = false end
						end
					end
				end
			end
		end
	else
		for _, objs in pairs(eggObjects) do
			if objs.Box then objs.Box.Visible = false end
			if objs.Text then objs.Text.Visible = false end
		end
	end

	if playerEspEnabled then
		for _, plr in pairs(Players:GetPlayers()) do
			if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
				if not playerObjects[plr] then createPlayerESP(plr) end
				local hrp = plr.Character.HumanoidRootPart
				local vec, onScreen = Camera:WorldToViewportPoint(hrp.Position)
				local objs = playerObjects[plr]
				if onScreen and objs then
					local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
					local sf = math.clamp(1200 / dist, 20, 350)
					objs.Box.Size = Vector2.new(sf * 0.6, sf * 1.2)
					objs.Box.Position = Vector2.new(vec.X - objs.Box.Size.X / 2, vec.Y - objs.Box.Size.Y / 2)
					objs.Box.Visible = true
					objs.Text.Text = plr.Name .. " [" .. math.floor(dist) .. "m]"
					objs.Text.Position = Vector2.new(vec.X, vec.Y - objs.Box.Size.Y / 2 - 16)
					objs.Text.Visible = true
				else
					if objs then objs.Box.Visible = false; objs.Text.Visible = false end
				end
			end
		end
	else
		for _, objs in pairs(playerObjects) do
			if objs.Box then objs.Box.Visible = false end
			if objs.Text then objs.Text.Visible = false end
		end
	end
end)

