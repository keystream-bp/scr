local dragging, dragInput, dragStart, startPos

titleBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = mainFrame.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then dragging = false end
		end)
	end
end)

titleBar.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		local delta = input.Position - dragStart
		mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

local isMenuOpen = false
local isMinimized = false
local fullSize = UDim2.new(0, 520, 0, 360)
local minSize = UDim2.new(0, 520, 0, 45)

local function openMenu()
	if isMenuOpen then return end
	isMenuOpen = true
	isMinimized = false
	minimizeButton.Text = "-"
	mainFrame.Visible = true
	mainFrame.Size = fullSize
	mainFrame.Position = UDim2.new(0.5, 0, 1.5, 0)
	TweenService:Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Position = UDim2.new(0.5, 0, 0.5, 0)
	}):Play()
end

local function closeMenu()
	if not isMenuOpen then return end
	isMenuOpen = false
	TweenService:Create(mainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		Position = UDim2.new(0.5, 0, -0.5, 0)
	}):Play()
	task.wait(0.25)
	if not isMenuOpen then mainFrame.Visible = false end
end

local function toggleMinimize()
	if not isMenuOpen then return end
	if isMinimized then
		isMinimized = false
		minimizeButton.Text = "-"
		TweenService:Create(mainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = fullSize}):Play()
	else
		isMinimized = true
		minimizeButton.Text = "+"
		TweenService:Create(mainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = minSize}):Play()
	end
end

toggleButton.MouseButton1Click:Connect(function()
	if isMenuOpen then closeMenu() else openMenu() end
end)
closeButton.MouseButton1Click:Connect(closeMenu)
minimizeButton.MouseButton1Click:Connect(toggleMinimize)

-- Tự động bật menu sau khi chạy xong thông báo intro
task.delay(1.5, openMenu)

