local function showNotification(title, text, duration)
	local notifGui = Instance.new("Frame")
	notifGui.Size = UDim2.new(0, 300, 0, 75)
	notifGui.Position = UDim2.new(1, 20, 0, 20) -- Bắt đầu từ ngoài màn hình bên phải
	notifGui.AnchorPoint = Vector2.new(1, 0)
	notifGui.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
	notifGui.BorderSizePixel = 0
	notifGui.Parent = screenGui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = notifGui

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(60, 60, 80)
	stroke.Thickness = 1.5
	stroke.Parent = notifGui

	local titleLabel = Instance.new("TextLabel")
	titleLabel.Size = UDim2.new(1, -20, 0, 25)
	titleLabel.Position = UDim2.new(0, 12, 0, 8)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Text = title
	titleLabel.TextColor3 = Color3.fromRGB(130, 130, 255)
	titleLabel.TextSize = 15
	titleLabel.Font = Enum.Font.GothamBold
	titleLabel.TextXAlignment = Enum.TextXAlignment.Left
	titleLabel.Parent = notifGui

	local descLabel = Instance.new("TextLabel")
	descLabel.Size = UDim2.new(1, -20, 0, 30)
	descLabel.Position = UDim2.new(0, 12, 0, 33)
	descLabel.BackgroundTransparency = 1
	descLabel.Text = text
	descLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
	descLabel.TextSize = 13
	descLabel.Font = Enum.Font.Gotham
	descLabel.TextXAlignment = Enum.TextXAlignment.Left
	descLabel.Parent = notifGui

	-- Hiệu ứng trượt vào
	TweenService:Create(notifGui, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Position = UDim2.new(1, -20, 0, 20)
	}):Play()

	task.delay(duration or 4, function()
		if notifGui and notifGui.Parent then
			TweenService:Create(notifGui, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
				Position = UDim2.new(1, 350, 0, 20)
			}):Play()
			task.wait(0.3)
			notifGui:Destroy()
		end
	end)
end

